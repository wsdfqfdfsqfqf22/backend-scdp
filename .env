# =========================
# SECURITY
# =========================
# IMPORTANT : Changez cette clé en production (min. 32 caractères aléatoires)
# Générer une nouvelle clé : python -c "import secrets; print(secrets.token_hex(32))"
SCDP_SECRET_KEY=9f3c2b7e8a1d4c6f9b2e7d8c1a0f5e6d9c3b7a1f4e8d2c6b9a0f1e3d5c7b8a2
ALGORITHM=HS256

# =========================
# CORS
# =========================
# Plusieurs origines séparées par des virgules
SCDP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =========================
# TOKENS
# =========================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =========================
# APP
# =========================
APP_VERSION=1.0.0

# =========================
# DATABASE — MySQL uniquement
# =========================
# Format : mysql+pymysql://user:password@host:port/dbname?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/scdp?charset=utf8mb4
